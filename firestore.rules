rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.email == 'awanproject54@gmail.com' && request.auth.token.email_verified == true; }
    function lic(k) { return get(/databases/$(database)/documents/licenses/$(k)).data; }
    function blic(k) { return get(/databases/$(database)/documents/bts_licenses/$(k)).data; }

    // ===== Dipakai bersama kedua ebook (stats/ptl dan stats/bts) =====
    match /stats/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['readers','likes']) && request.resource.data.get('readers',0) <= 1 && request.resource.data.get('likes',0) <= 1 && request.resource.data.get('likes',0) >= 0;
      allow update: if request.resource.data.keys().hasOnly(['readers','likes'])
        && request.resource.data.get('readers',0) - resource.data.get('readers',0) >= 0
        && request.resource.data.get('readers',0) - resource.data.get('readers',0) <= 1
        && request.resource.data.get('likes',0) - resource.data.get('likes',0) >= -1
        && request.resource.data.get('likes',0) - resource.data.get('likes',0) <= 1;
    }

    // ===== Ebook 1: Pulang Tanpa Luka (aturan lama, tidak diubah; content dibatasi ke dokumen ptl) =====
    match /licenses/{key} {
      allow get: if request.auth != null;
      allow list, create, delete: if admin();
      allow update: if admin() || (request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uids'])
        && request.resource.data.uids.size() <= resource.data.max
        && request.resource.data.uids.hasAll(resource.data.uids)
        && request.resource.data.uids.hasAny([request.auth.uid]));
    }
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && lic(request.resource.data.key).uids.hasAny([uid]);
    }
    match /content/ptl {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && lic(get(/databases/$(database)/documents/members/$(request.auth.uid)).data.key).uids.hasAny([request.auth.uid]);
      allow write: if admin();
    }

    // ===== Ebook 2: Bahagia Tanpa Syarat (koleksi terpisah, awalan bts_) =====
    match /bts_licenses/{key} {
      allow get: if request.auth != null;
      allow list, create, delete: if admin();
      allow update: if admin() || (request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uids'])
        && request.resource.data.uids.size() <= resource.data.max
        && request.resource.data.uids.hasAll(resource.data.uids)
        && request.resource.data.uids.hasAny([request.auth.uid]));
    }
    match /bts_members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && blic(request.resource.data.key).uids.hasAny([uid]);
    }
    match /content/bts {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/bts_members/$(request.auth.uid))
        && blic(get(/databases/$(database)/documents/bts_members/$(request.auth.uid)).data.key).uids.hasAny([request.auth.uid]);
      allow write: if admin();
    }

    // orders, webhook_logs, bts_orders, bts_webhook_logs: tanpa aturan = hanya server (service account).
  }
}
